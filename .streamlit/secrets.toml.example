# Copy to .streamlit/secrets.toml locally. Never commit real credentials.
[supabase]
url = "https://YOUR_PROJECT.supabase.co"
publishable_key = "sb_publishable_REPLACE_WITH_PROJECT_PUBLIC_KEY"
# Legacy anon JWT is also supported; service_role/sb_secret_* is rejected.

# Optional overrides only if live column names differ from the notebook export.
# Every value is validated against an actual Supabase row before querying it.
# [supabase.columns.segment_summary]
# model = "model"
# k = "k"
# cluster = "cluster_code"
# name = "nama_segmen"
# customers = "jumlah_label"
# monetary = "total_monetary_rp"
#
# [supabase.columns.faktur_lolos_dengan_klaster]
# company = "nama_klien"
# invoice_id = "id_kelompok_faktur"
# date = "tanggal_faktur"
# amount = "grand_total_rp"
# kmeans_k4 = "kmeans_k4_cluster"
# gmm_k3 = "gmm_k3_cluster"
# gmm_k4 = "gmm_k4_cluster"

# NLP runs inside Streamlit. No FastAPI URL or service token is needed.
# Private GitHub release assets are required on a fresh Community Cloud instance.
[nlp_models]
repository = "OWNER/PRIVATE_MODEL_REPOSITORY"
read_token = "REPLACE_WITH_READ_ONLY_GITHUB_TOKEN"
model_asset_id = "REPLACE_WITH_NUMERIC_MODEL_ASSET_ID"
vectorizer_asset_id = "REPLACE_WITH_NUMERIC_VECTORIZER_ASSET_ID"

# Optional private sender-to-role overrides; default is the synthetic demo mapping.
# Do not put actual customer names in a committed example.
# [nlp_roles]
# "Synthetic Support" = "ADMIN"
# "Synthetic Customer" = "CLIENT"
# "SYSTEM" = "SYSTEM"
